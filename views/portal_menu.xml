<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ENTRADA EN EL PORTAL HOME - TAREAS DE PAGO -->
    <template id="portal_my_home_payment_tasks" name="Portal My Home : payment tasks entries" inherit_id="portal.portal_my_home" priority="35">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Tareas de Recibo de Pago</t>
                <t t-set="url" t-value="'/my/payment-tasks'"/>
                <t t-set="text">Gestionar tareas de verificación de recibos</t>
                <t t-set="count" t-value="payment_task_count or 0"/>
            </t>
        </xpath>
    </template>

</odoo>
