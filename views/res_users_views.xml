<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend res.users form to add delivery task permissions -->
        <record id="view_users_form_delivery_ext" model="ir.ui.view">
            <field name="name">res.users.form.delivery_ext</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Add our custom field to the Access Rights page -->
                <xpath expr="//page[@name='access_rights']" position="inside">
                    <group string="Tareas de Recibo de Pago" name="delivery_tasks">
                        <field name="is_payment_user"
                               help="Permitir que este usuario de portal vea y complete tareas de entrega de recibos de pago"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
