<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Payment Task Form View -->
        <record id="view_payment_task_form" model="ir.ui.view">
            <field name="name">delivery_expenses.payment_task.form</field>
            <field name="model">delivery_expenses.payment_task</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,in_progress,completed"/>
                        <button name="action_mark_completed" string="Completar" type="object" class="btn-success" states="in_progess"/>
                        <button name="action_back_to_draft" string="Devolver a Borrador" type="object" class="btn-info" states="cancelled"/>
                        <button name="action_cancel" string="Cancelar" type="object" class="btn-secondary" states="completed" invisible="1"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                        </div>

                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>

                        <group>
                            <field name="receipt_name" readonly="1" string="Recibo"/>
                            <field name="supplier_name" readonly="1" string="Proveedor"/>
                            <field name="bank_name" readonly="1" string="Banco Destino"/>
                        </group>

                        <group>
                            <field name="receipt_amount" readonly="1" string="Monto"/>
                            <field name="receipt_date" readonly="1" string="Fecha Recibo"/>
                            <field name="created_date" readonly="1" string="Fecha de Creación"/>
                            <field name="deadline" readonly="1" string="Fecha Límite"/>
                            <field name="assigned_user_id" domain="[('user_ids', '!=', False)]" string="Repartidor/Mensajero"/>
                            <field name="check_amount_in_words" readonly="1" string="Monto en Letras"/>
                        </group>
                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Payment Task Tree View -->
        <record id="view_payment_task_tree" model="ir.ui.view">
            <field name="name">delivery_expenses.payment_task.tree</field>
            <field name="model">delivery_expenses.payment_task</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="receipt_name"/>
                    <field name="supplier_name"/>
                    <field name="deadline"/>
                    <field name="assigned_user_id"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- Action to view payment tasks -->
        <record id="action_payment_task" model="ir.actions.act_window">
            <field name="name">Tareas de Envío</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">delivery_expenses.payment_task</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref=""/>
        </record>

    </data>
</odoo>
