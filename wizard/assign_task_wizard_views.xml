<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Assign Task Wizard Form View -->
        <record id="view_assign_task_wizard_form" model="ir.ui.view">
            <field name="name">delivery_expenses.assign_task_wizard.form</field>
            <field name="model">delivery_expenses.assign_task_wizard</field>
            <field name="arch" type="xml">
                <form string="Asignar Tarea de Envío">
                    <div class="alert alert-info" role="alert">
                        <p><i class="fa fa-info-circle me-2"/>
                            Asigna esta tarea de envío a un repartidor o mensajero y establece la fecha límite.
                        </p>
                    </div>

                    <group>
                        <field name="payment_receipt_id" readonly="1" nolabel="1"/>
                    </group>

                    <separator string="Datos de Asignación"/>
                    <group>
                        <group>
                            <label for="assigned_user_id" string="Repartidor/Mensajero"/>
                            <div>
                                <field name="assigned_user_id" required="1" nolabel="1"
                                       domain="[('user_ids', '!=', False)]"
                                       placeholder="Selecciona el repartidor..."/>
                            </div>
                        </group>
                        <group>
                            <label for="deadline" string="Fecha Límite de Entrega"/>
                            <div>
                                <field name="deadline" required="1" nolabel="1"
                                       widget="date"
                                       placeholder="Selecciona la fecha..."/>
                            </div>
                        </group>
                    </group>

                    <footer>
                        <button name="action_create_task" string="Crear y Enviar"
                                type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open wizard from supplier.payment.receipt -->
        <record id="action_assign_task_wizard" model="ir.actions.act_window">
            <field name="name">Asignar Tarea de Envío</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">delivery_expenses.assign_task_wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_assign_task_wizard_form"/>
            <field name="target">new</field>
            <field name="binding_model_id" ref="supplier_payment_receipts.model_supplier_payment_receipt"/>
            <field name="binding_view_types">form</field>
        </record>


    </data>
</odoo>
