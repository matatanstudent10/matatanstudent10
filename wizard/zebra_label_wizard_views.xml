<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista del wizard -->
        <record id="view_zebra_label_wizard_form" model="ir.ui.view">
            <field name="name">zebra.label.wizard.form</field>
            <field name="model">zebra.label.wizard</field>
            <field name="arch" type="xml">
                <form string="Generar Etiquetas Zebra">
                    <group>
                        <field name="picking_id" invisible="1"/>
                        <field name="printer_model" widget="radio"/>
                        <field name="num_packages"/>
                    </group>
                    <footer>
                        <button string="Generar PDF" name="action_print_labels" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acción para abrir el wizard -->
        <record id="action_zebra_label_wizard" model="ir.actions.act_window">
            <field name="name">Imprimir Etiquetas Zebra</field>
            <field name="res_model">zebra.label.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="stock.model_stock_picking"/>
        </record>
    </data>
</odoo>
